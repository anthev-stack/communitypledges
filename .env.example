# =============================================================================
# Community Pledges — environment variables
# Copy to .env locally, or /var/www/communitypledges/.env on Vultr
# Production: NEXTAUTH_URL=https://communitypledges.com
# =============================================================================

# --- Required: database (PostgreSQL) ---
# Local dev: docker compose -f docker-compose.dev.yml up -d
# Production: Vultr managed Postgres, Neon, or Postgres on the same VPS
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- Required: NextAuth (session + Discord OAuth) ---
# Generate: openssl rand -base64 32  (or PowerShell in SETUP.md)
NEXTAUTH_SECRET="your-secret-key-change-this"
NEXTAUTH_URL="http://localhost:3000"

# --- Required: Discord OAuth ---
# https://discord.com/developers/applications → OAuth2
# Redirect: {NEXTAUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# --- Required for registration: hCaptcha ---
# Dev test keys (below). Production: https://dashboard.hcaptcha.com/
NEXT_PUBLIC_HCAPTCHA_SITE_KEY="10000000-ffff-ffff-ffff-000000000001"
HCAPTCHA_SECRET_KEY="0x0000000000000000000000000000000000000000"

# --- Required for payments: Stripe ---
# https://dashboard.stripe.com/apikeys (use live keys in production)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook: https://communitypledges.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Required for email notifications: Resend ---
# https://resend.com/api-keys — verify domain communitypledges.com
RESEND_API_KEY="re_..."

# --- Optional: Twitch live stream on homepage ---
# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# --- Optional: cron (pledge withdrawals) ---
# Call: Authorization: Bearer {CRON_SECRET}
# e.g. curl -H "Authorization: Bearer $CRON_SECRET" https://communitypledges.com/api/cron/process-withdrawals
CRON_SECRET=""

# --- Runtime ---
NODE_ENV="production"
